{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

{{ 'wellie-product.liquid-stylesheet.css' | asset_url | stylesheet_tag }}

<section
  class="wellie-product page-width py-8 md:py-12 lg:py-16"
  style="font-family: var(--font-secondary--family);"
  data-product-id="{{ product.id }}"
  data-product-section>
  <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
    {%- comment -%}
      Product media
    {%- endcomment -%}
    <div class="wellie-product__media">
      <div class="relative overflow-hidden rounded-lg bg-muted/20" data-wellie-gallery>
        {%- for media in product.media -%}
          <div
            class="{% unless forloop.first %}hidden{% endunless %}"
            data-media-id="{{ media.id }}"
            data-wellie-media="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <img
                  src="{{ media | image_url: width: 1200 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="1200"
                  height="{{ 1200 | divided_by: media.aspect_ratio | round }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  class="block h-auto w-full object-cover">

              {%- when 'video' -%}
                {{ media | video_tag: 	autoplay: true, 	controls: false, 	muted: true, 	class: 'block w-full'
                }}

              {%- when 'external_video' -%}
                {{ media | external_video_tag: class: 'block w-full' }}

              {%- when 'model' -%}
                {{ media | model_viewer_tag: class: 'block w-full' }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
        {%- if product.media.size > 1 -%}
          <button type="button" class="wellie-product__gallery-arrow wellie-product__gallery-arrow--previous" data-wellie-gallery-previous aria-label="Previous product image">‹</button>
          <button type="button" class="wellie-product__gallery-arrow wellie-product__gallery-arrow--next" data-wellie-gallery-next aria-label="Next product image">›</button>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="mt-3 flex gap-2 overflow-x-auto">
          {%- for media in product.media -%}
            <button
              type="button"
              class="wellie-product__thumbnail shrink-0 overflow-hidden rounded border border-border transition-opacity hover:opacity-75{% if forloop.first %} opacity-100{% else %} opacity-60{% endif %}"
              data-wellie-thumbnail="{{ media.id }}"
              aria-label="View product media {{ forloop.index }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
              {%- if media.media_type == 'image' -%}
                <img
                  src="{{ media | image_url: width: 180 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="90"
                  height="{{ 90 | divided_by: media.aspect_ratio | round }}"
                  loading="lazy"
                  class="h-[72px] w-[72px] object-cover">
              {%- else -%}
                <div class="flex h-[72px] w-[72px] items-center justify-center bg-muted/20 text-xs text-muted">
                  {{ media.media_type | capitalize }}
                </div>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- comment -%}
      Product information
    {%- endcomment -%}
    <div class="wellie-product__info lg:pt-4">
      <p class="wellie-product__badge">{{ section.settings.product_badge }}</p>
      <h1 class="mb-3 text-3xl font-bold leading-tight md:text-4xl">
        {{ product.title }}
      </h1>


      {%- comment -%}
        Price
      {%- endcomment -%}
      <div class="wellie-product__price-block mb-6 flex flex-wrap items-center gap-3">
        <span class="text-2xl font-semibold" data-product-price>
          {{ current_variant.price | money }}
        </span>

        <s class="text-base text-muted{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}" data-product-compare-price>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {{ current_variant.compare_at_price | money }}
          {%- endif -%}
        </s>

        {%- liquid
          assign discount = 0

          if current_variant.compare_at_price > current_variant.price
            assign discount_amount = current_variant.compare_at_price | minus: current_variant.price
            assign discount = discount_amount | times: 100 | divided_by: current_variant.compare_at_price | round
          endif
        -%}

        <span class="rounded-full bg-error/10 px-2 py-1 text-xs font-medium text-error{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}" data-product-discount>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {{ discount }}% off
          {%- endif -%}
        </span>
      </div>
      <p class="wellie-product__tax-note">MRP Inclusive of all taxes</p>

      {%- for block in section.blocks -%}
        {%- if block.type == 'product_proof' -%}
          <div class="wellie-product__health-proof" {{ block.shopify_attributes }}>
            <span class="wellie-product__health-icon" aria-hidden="true">♥</span>
            <div>
              {%- if block.settings.heading != blank -%}<p><strong>{{ block.settings.heading }}</strong></p>{%- endif -%}
              {%- if block.settings.copy != blank -%}<small>{{ block.settings.copy }}</small>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%}
        Variant selector
      {%- endcomment -%}
      {%- if product.has_only_default_variant == false -%}
        {%- assign product_options = product.options | join: ',' -%}

        <div>
          {% render 'variant-selector'
            , product: product
            , options: product_options
            , swatch_size: 'lg'
            , show_labels: true
            , color_display: 'image'
            , pill_style: 'outline'
            , show_variant_discount: true
          %}
        </div>
      {%- endif -%}

      {%- comment -%}
        Add to cart
      {%- endcomment -%}
      <div class="wellie-product__purchase mb-6">
        {% render 'product-form'
          , product: product %}
        <button
          class="wellie-product__buy-button"
          type="submit"
          form="product-form-{{ product.id }}"
          name="return_to"
          value="/checkout"
          data-buy-now
          {% unless current_variant.available %}disabled{% endunless %}
        >
          Buy it now
        </button>
        <div class="wellie-product__offers">
          {%- for block in section.blocks -%}
            {%- if block.type == 'offer' -%}
              <button type="button" class="wellie-product__offer" data-copy-code="{{ block.settings.code | escape }}" {{ block.shopify_attributes }}>
                <span aria-hidden="true">✧</span>
                <span><strong>{{ block.settings.heading }}</strong><small>{{ block.settings.copy }}</small></span>
                <span aria-hidden="true">□</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

<script src="{{ 'product.js' | asset_url }}" defer></script>
<script src="{{ 'wellie-product.liquid-javascript.js' | asset_url }}" defer></script>

{% schema %}
  {
    "name": "Wellie product",
    "tag": "section",
    "class": "wellie-product-section",
    "settings": [
      {
        "type": "text",
        "id": "product_badge",
        "label": "Product badge",
        "default": "India's #1 Advanced Dog Food"
      }
    ],
    "blocks": [
      {
        "type": "product_proof",
        "name": "Product proof",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "30% Digestive Health Improvement"
          },
          {
            "type": "text",
            "id": "copy",
            "label": "Supporting text",
            "default": "Results may vary based on pet size, diet, and See Reports"
          }
        ]
      },
      {
        "type": "offer",
        "name": "Offer",
        "limit": 2,
        "settings": [
          { "type": "text", "id": "heading", "label": "Heading", "default": "Get it for ₹3,190" },
          { "type": "text", "id": "copy", "label": "Copy", "default": "Copy code to get 10% off" },
          { "type": "text", "id": "code", "label": "Coupon code" }
        ]
      }
    ],
    "presets": [
      {
        "name": "Wellie product",
        "blocks": [
          {
            "type": "product_proof"
          }
        ]
      }
    ]
  }
{% endschema %}
