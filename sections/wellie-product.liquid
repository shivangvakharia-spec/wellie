{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<section
  class="wellie-product page-width py-8 md:py-12 lg:py-16"
  data-product-id="{{ product.id }}"
  data-product-section>
  <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
    {%- comment -%}
      Product media
    {%- endcomment -%}
    <div class="wellie-product__media">
      <div class="grid gap-3">
        {%- for media in product.media -%}
          <div class="{% if forloop.first %}block{% else %}hidden lg:block{% endif %}" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <img
                  src="{{ media | image_url: width: 1000 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="1000"
                  height="{{ 1000 | divided_by: media.aspect_ratio | round }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  class="w-full rounded-lg">

              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, controls: false, muted: true, class: 'w-full rounded-lg'
                }}

              {%- when 'external_video' -%}
                {{ media | external_video_tag: class: 'w-full rounded-lg' }}

              {%- when 'model' -%}
                {{ media | model_viewer_tag: class: 'w-full rounded-lg' }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%}
        Product thumbnails
      {%- endcomment -%}
      {%- if product.media.size > 1 -%}
        <div class="mt-3 grid grid-cols-5 gap-2">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button
                type="button"
                class="overflow-hidden rounded border border-border transition-opacity hover:opacity-75"
                data-media-thumbnail="{{ media.id }}"
                aria-label="View product image {{ forloop.index }}">
                <img
                  src="{{ media | image_url: width: 160 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="160"
                  height="{{ 160 | divided_by: media.aspect_ratio | round }}"
                  loading="lazy"
                  class="aspect-square w-full object-cover">
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%}
      Product information
    {%- endcomment -%}
    <div class="wellie-product__info lg:pt-4">
      {%- if product.vendor != blank -%}
        <p class="mb-2 text-sm text-muted">
          {{ product.vendor }}
        </p>
      {%- endif -%}

      <h1 class="mb-3 text-3xl font-bold leading-tight md:text-4xl">
        {{ product.title }}
      </h1>

      {%- comment -%}
        Rating placeholder.
        We will connect this to the actual review data later.
      {%- endcomment -%}
      <div class="mb-4 flex items-center gap-2">
        <span class="text-sm" aria-label="Product rating">
          ★★★★★
        </span>
        <span class="text-sm text-muted">
          4.9
        </span>
      </div>

      {%- comment -%}
        Price
      {%- endcomment -%}
      <div class="mb-6 flex flex-wrap items-center gap-3">
        <span class="text-2xl font-semibold" data-product-price>
          {{ current_variant.price | money }}
        </span>

        <s class="text-base text-muted{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}" data-product-compare-price>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {{ current_variant.compare_at_price | money }}
          {%- endif -%}
        </s>

        {%- liquid
          assign discount = 0

          if current_variant.compare_at_price > current_variant.price
            assign discount_amount = current_variant.compare_at_price | minus: current_variant.price
            assign discount = discount_amount | times: 100 | divided_by: current_variant.compare_at_price | round
          endif
        -%}

        <span class="rounded-full bg-error/10 px-2 py-1 text-xs font-medium text-error{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}" data-product-discount>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {{ discount }}% off
          {%- endif -%}
        </span>
      </div>

      {%- comment -%}
        Product description
      {%- endcomment -%}
      {%- if product.description != blank -%}
        <div class="mb-6 text-sm leading-6 text-muted">
          {{ product.description }}
        </div>
      {%- endif -%}

      {%- comment -%}
        Variant selector
      {%- endcomment -%}
      {%- if product.has_only_default_variant == false -%}
        <div class="mb-6">
          {% render 'variant-selector'
            , product: product
            , options: 'color,size'
            , swatch_size: 'lg'
            , show_labels: true
            , color_display: 'image'
            , pill_style: 'outline'
          %}
        </div>
      {%- endif -%}

      {%- comment -%}
        Add to cart
      {%- endcomment -%}
      <div class="mb-6">
        {% render 'product-form'
          , product: product %}
      </div>

      {%- comment -%}
        Product highlights.
        These are temporary placeholders for the information
        shown in the Figma. We will make these configurable later.
      {%- endcomment -%}
      <div class="border-t border-border pt-5">
        <ul class="space-y-3 text-sm">
          <li class="flex items-center gap-3">
            <span aria-hidden="true">✓</span>
            <span>Made with premium ingredients</span>
          </li>

          <li class="flex items-center gap-3">
            <span aria-hidden="true">✓</span>
            <span>Healthy treats for your pet</span>
          </li>

          <li class="flex items-center gap-3">
            <span aria-hidden="true">✓</span>
            <span>Fast and reliable delivery</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
  {
    "name": "Wellie product",
    "tag": "section",
    "class": "wellie-product-section",
    "settings": [],
    "presets": [
      {
        "name": "Wellie product"
      }
    ]
  }
{% endschema %}