{%- liquid
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign animation_duration = section.settings.scroll_speed | default: 30
  assign has_marquee = false
  if section.blocks.size > 1
    assign has_marquee = true
  endif
-%}

{%- if section.blocks.size > 0 -%}
  <div
    class="announcement-bar overflow-hidden px-4 py-[5px] sm:px-6 lg:px-[69px]"
    id="announcement-bar-{{ section.id }}"
    style="background-color: {{ bg_color }}; color: {{ text_color }};"
  >
    {%- if has_marquee -%}
      <div
        class="announcement-bar__track inline-flex items-center gap-[9px] whitespace-nowrap hover:[animation-play-state:paused]"
        style="animation: scroll {{ animation_duration }}s linear infinite;"
      >
        {%- for i in (1..10) -%}
          {%- assign is_first_pass = false -%}
          {%- if i == 1 -%}
            {%- assign is_first_pass = true -%}
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- render 'announcement-bar-item', block: block, include_shopify_attributes: is_first_pass -%}
            <span
              class="inline-block h-1 w-1 flex-shrink-0 rounded-full"
              style="background-color: {{ text_color }};"
              aria-hidden="true"
            ></span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="flex w-full items-center justify-center gap-[9px] text-center">
        {%- for block in section.blocks -%}
          {%- render 'announcement-bar-item', block: block, include_shopify_attributes: true -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#025A60"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F9F3F1"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (seconds)",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 30,
      "info": "Lower = faster, higher = slower. Only applies once 2 or more announcements are added — a single announcement is shown statically."
    }
  ],
  "blocks": [
    {
      "type": "announcement-bar-item",
      "name": "Announcement",
      "settings": [
        {
          "type": "richtext",
          "id": "announcement_bar_text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Leave blank to show plain text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement-bar-item",
          "settings": {
            "announcement_bar_text": "<p>15% Off over ₹5000 Use Code WELLIEWOW</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .announcement-bar {
    --announcement-bar-background: #025a60;
    --announcement-bar-foreground: #f9f3f1;

    display: flex;
    align-items: center;
    min-height: 1.5625rem;
    padding-block: 0.3125rem;
    background: var(--announcement-bar-background);
    color: var(--announcement-bar-foreground);
  }

  .announcement-bar__item {
    font-family: var(--font-tertiary--family);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 0.9375rem;
  }

  .announcement-bar__item p {
    margin: 0;
  }
{% endstylesheet %}
