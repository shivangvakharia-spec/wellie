{{ 'wellie-journey-stylesheet.css' | asset_url | stylesheet_tag }}

<section class="wellie-journey" aria-label="Start your journey with Wellie">

  <div class="wellie-journey__inner">

    <h2 class="wellie-journey__heading">
      Start Your Journey With Wellie
    </h2>

    <div class="wellie-journey__content">

      <div class="wellie-journey__image-wrapper">
        {% if section.settings.image != blank %}
          {{
            section.settings.image | image_url: width: 708 | image_tag: class: 'wellie-journey__image', loading: 'lazy'
          }}
        {% else %}
          <div class="wellie-journey__image-placeholder">
            Select an image
          </div>
        {% endif %}
      </div>

      <div class="wellie-journey__timeline">

        {% if section.blocks.size > 0 %}

          {%- comment -%}
            Use manually added Journey Step blocks
            when the merchant has configured them.
          {%- endcomment -%}

          {% for block in section.blocks %}

            <div class="wellie-journey__timeline-row" {{ block.shopify_attributes }}>

              <!-- Month -->

              <div class="wellie-journey__month">
                {{ block.settings.month }}
              </div>


              <!-- Journey detail -->

              <article class="wellie-journey__detail">

                <h3 class="wellie-journey__title">
                  {{ block.settings.title }}
                </h3>

                <div class="wellie-journey__descriptions">

                  {% if block.settings.description_1 != blank %}
                    <p class="wellie-journey__description">
                      <span class="wellie-journey__bullet">•</span>
                      <span>{{ block.settings.description_1 }}</span>
                    </p>
                  {% endif %}

                  {% if block.settings.description_2 != blank %}
                    <p class="wellie-journey__description">
                      <span class="wellie-journey__bullet">•</span>
                      <span>{{ block.settings.description_2 }}</span>
                    </p>
                  {% endif %}

                </div>

              </article>

            </div>

          {% endfor %}

        {% else %}

          {%- comment -%}
            No Journey Step blocks have been added.
            Use the journey metaobject as the fallback source.
          {%- endcomment -%}

          {% assign journey_steps = shop.metaobjects.journey.values | sort: 'month' %}

{% for journey in journey_steps %}

  <div class="wellie-journey__timeline-row">

    <div class="wellie-journey__month">
      Month {{ journey.month.value }}
    </div>

    <article class="wellie-journey__detail">

      <h3 class="wellie-journey__title">
        {{ journey.title.value }}
      </h3>

      <div class="wellie-journey__descriptions">

        {% for description in journey.description.value %}

          {% if description != blank %}
            <p class="wellie-journey__description">
              <span class="wellie-journey__bullet">•</span>
              <span>{{ description }}</span>
            </p>
          {% endif %}

        {% endfor %}

      </div>

    </article>

  </div>

{% endfor %}

        {% endif %}

      </div>

    </div>

  </div>

</section>

<script src="{{ 'wellie-journey-javascript.js' | asset_url }}" defer></script>

{% schema %}

  {
    "name": "Wellie journey",

    "tag": "section",

    "class": "wellie-journey-section",

    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Journey image"
      }
    ],

    "blocks": [
      {
        "type": "journey_step",

        "name": "Journey step",

        "settings": [
          {
            "type": "text",
            "id": "month",
            "label": "Month",
            "default": "Month 1"
          }, {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Initial adaptation and digestive support"
          }, {
            "type": "textarea",
            "id": "description_1",
            "label": "Description 1",
            "default": "The prebiotics help improve nutrient absorption."
          }, {
            "type": "textarea",
            "id": "description_2",
            "label": "Description 2",
            "default": "Enhanced digestion often leads to an improved appetite."
          }
        ]
      }
    ],

    "presets": [
      {
        "name": "Wellie journey",

      }
    ]
  }

{% endschema %}