{{ 'wellie-vet-check-stylesheet.css' | asset_url | stylesheet_tag }}

<section class="wellie-vet-check" aria-label="{{ section.settings.heading | escape }}">

  <div class="wellie-vet-check__card">

    <!-- =====================================================
      Image
      ===================================================== -->
    {% if section.settings.image != blank %}

      {{
        section.settings.image | image_url: width: 708 | image_tag: class: 'wellie-vet-check__image', loading: 'lazy', widths: '354, 708', sizes: '(max-width: 749px) calc(100vw - 40px), 354px'
      }}

    {% endif %}


    <!-- =====================================================
      Image Gradient
      ===================================================== -->
    <div class="wellie-vet-check__image-gradient" aria-hidden="true"></div>


    <!-- =====================================================
      Content
      ===================================================== -->
    <div class="wellie-vet-check__content">

      <div class="wellie-vet-check__text">

        {% if section.settings.heading != blank %}

          <h2 class="wellie-vet-check__heading">
            {{ section.settings.heading }}
          </h2>

        {% endif %}


        {% if section.settings.description != blank %}

          <p class="wellie-vet-check__description">
            {{ section.settings.description }}
          </p>

        {% endif %}

      </div>


      <!-- ===================================================
        Copy Button
        =================================================== -->
      <button
        type="button"
        class="wellie-vet-check__copy-button"
        data-vet-copy
        data-copy-text="{{ section.settings.description | escape }}">

        <span class="wellie-vet-check__copy-icon" aria-hidden="true">
          <svg
            width="18"
            height="18"
            viewBox="0 0 18 18"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <path
              d="M6.75 6H14.25V13.5H6.75V6Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round" />
            <path
              d="M3.75 12V3.75H12"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round" />
          </svg>
        </span>

        <span class="wellie-vet-check__copy-label">
          {{ section.settings.button_text }}
        </span>

      </button>

    </div>

  </div>

</section>


<script src="{{ 'wellie-vet-check-javascript.js' | asset_url }}" defer></script>


{% schema %}

  {
    "name": "Wellie vet check",

    "tag": "section",

    "class": "wellie-vet-check-section",

    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Veterinarian image"
      }, {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Check with my vet"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Message",
        "default": "Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown."
      }, {
        "type": "text",
        "id": "button_text",
        "label": "Button text",
        "default": "Copy Message"
      }
    ],

    "presets": [
      {
        "name": "Wellie vet check"
      }
    ]
  }

{% endschema %}