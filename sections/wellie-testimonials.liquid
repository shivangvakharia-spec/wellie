{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
-%}

{%- if review_blocks.size > 0 or request.design_mode -%}
  <section class="wellie-testimonials-section">
    <div class="wellie-testimonials page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="wellie-testimonials__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if review_blocks.size > 0 -%}
        <div class="wellie-testimonials__list scrollbar-hide">
          {%- for block in review_blocks -%}
            {%- assign review = block.settings.review -%}
            {%- if review != blank -%}
              <div class="wellie-testimonials__item">
                {% render 'review-card', review: review, block: block %}
              </div>
            {%- elsif request.design_mode -%}
              <div class="wellie-testimonials__item wellie-testimonials__item--empty" {{ block.shopify_attributes }}>
                <p>Select a review to display it here.</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <p class="wellie-testimonials__empty">Add a review block, then select a review to display it here.</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .wellie-testimonials-section {
    padding-block: 3rem;
  }

  .wellie-testimonials {
    max-width: 80rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  .wellie-testimonials__heading {
    width: 100%;
    margin: 0;
    color: #3a3a3e;
    font-family: var(--font-tertiary--family);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 2.75rem;
    text-align: center;
  }

  .wellie-testimonials__empty {
    color: #3a3a3e;
    font-family: var(--font-tertiary--family);
    text-align: center;
  }

  .wellie-testimonials__list {
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
    width: 100%;
  }

  .wellie-testimonials__item {
    flex: 1 1 19.375rem;
    min-width: 19.375rem;
  }

  .wellie-testimonials__item--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 13.75rem;
    padding: 1rem;
    border: 0.0625rem dashed rgba(58, 58, 62, 0.3);
    border-radius: 0.5rem;
    color: rgba(58, 58, 62, 0.6);
    font-family: var(--font-tertiary--family);
    font-size: 0.875rem;
    text-align: center;
  }

  .wellie-testimonial-card {
    display: flex;
    height: 100%;
    min-height: 13.75rem;
    gap: 0.625rem;
    padding: 0.625rem;
    background: #ffffff;
    border: 0.0375rem solid rgba(58, 58, 62, 0.1);
    border-radius: 0.5rem;
  }

  .wellie-testimonial-card__photo {
    flex: 0 0 9.125rem;
    width: 9.125rem;
    height: 12.5rem;
    border-radius: 0.375rem;
    object-fit: cover;
    background: #d9d9d9;
  }

  .wellie-testimonial-card__photo--placeholder {
    background: #d9d9d9;
  }

  .wellie-testimonial-card__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    padding-block: 0.375rem 0.25rem;
  }

  .wellie-testimonial-card__top {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .wellie-testimonial-card__quote {
    flex: none;
    color: rgba(229, 40, 136, 0.35);
  }

  .wellie-testimonial-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .wellie-testimonial-card__rating {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: #ff9400;
  }

  .icon-star {
    flex: none;
  }

  .wellie-testimonial-card__text {
    margin: 0;
    color: #3a3a3e;
    font-family: var(--font-tertiary--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.0625rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .wellie-testimonial-card__author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wellie-testimonial-card__avatar {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .wellie-testimonial-card__name {
    color: #3a3a3e;
    font-family: var(--font-tertiary--family);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.125rem;
  }

  @media screen and (max-width: 749px) {
    .wellie-testimonials {
      align-items: flex-start;
      gap: 1.5rem;
    }

    .wellie-testimonials__heading {
      font-size: 1.5rem;
      line-height: 1.875rem;
    }

    .wellie-testimonials__list {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.25rem;
    }

    .wellie-testimonials__item {
      flex: 0 0 17.5rem;
      min-width: 17.5rem;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wellie testimonials",
  "tag": "section",
  "class": "wellie-testimonials-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hear from our Customers!"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "metaobject",
          "id": "review",
          "metaobject_type": "review",
          "label": "Review"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wellie testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
