{{ 'wellie-certified-stylesheet.css' | asset_url | stylesheet_tag }}

  <section class="wellie-certified" aria-label="{{ section.settings.heading | escape }}">

  <!-- =====================================================
    Decorative Background Shapes
    ===================================================== -->
  <div class="wellie-certified__shape wellie-certified__shape--top-left" aria-hidden="true"></div>

  <div class="wellie-certified__shape wellie-certified__shape--bottom-right" aria-hidden="true"></div>


  <!-- =====================================================
    Content
    ===================================================== -->
  <div class="wellie-certified__content">

    {% if section.settings.heading != blank %}

      <h2 class="wellie-certified__heading">
        {{ section.settings.heading }}
      </h2>

    {% endif %}


    <!-- =================================================
      Certification Logos
      ================================================= -->
    <div class="wellie-certified__logos">


      <!-- =================================================
        Logo 1 — HACCP
        ================================================= -->
      {% if section.settings.logo_1 != blank %}

        <div class="wellie-certified__logo">

          {{
            section.settings.logo_1 | image_url: width: 160 | image_tag: loading: 'lazy', widths: '60, 80, 120, 160', sizes: '(min-width: 750px) 80px, 60px', alt: section.settings.logo_1_alt
          }}

        </div>

      {% endif %}


      <!-- =================================================
        Logo 2 — GHP
        ================================================= -->
      {% if section.settings.logo_2 != blank %}

        <div class="wellie-certified__logo">

          {{
            section.settings.logo_2 | image_url: width: 160 | image_tag: loading: 'lazy', widths: '60, 80, 120, 160', sizes: '(min-width: 750px) 80px, 60px', alt: section.settings.logo_2_alt
          }}

        </div>

      {% endif %}


      <!-- =================================================
        Logo 3 — HACCP
        ================================================= -->
      {% if section.settings.logo_3 != blank %}

        <div class="wellie-certified__logo">

          {{
            section.settings.logo_3 | image_url: width: 160 | image_tag: loading: 'lazy', widths: '60, 80, 120, 160', sizes: '(min-width: 750px) 80px, 60px', alt: section.settings.logo_3_alt
          }}

        </div>

      {% endif %}


      <!-- =================================================
        Logo 4 — ISO
        ================================================= -->
      {% if section.settings.logo_4 != blank %}

        <div class="wellie-certified__logo">

          {{
            section.settings.logo_4 | image_url: width: 160 | image_tag: loading: 'lazy', widths: '60, 80, 120, 160', sizes: '(min-width: 750px) 80px, 60px', alt: section.settings.logo_4_alt
          }}

        </div>

      {% endif %}


      <!-- =================================================
        Logo 5 — FDA
        ================================================= -->
      {% if section.settings.logo_5 != blank %}

        <div class="wellie-certified__logo">

          {{
