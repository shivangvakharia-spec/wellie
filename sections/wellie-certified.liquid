        <div class="wellie-certified__logo">

          {{
            section.settings.logo_9 | image_url: width: 160 | image_tag: loading: 'lazy', widths: '60, 80, 120, 160', sizes: '(min-width: 750px) 80px, 60px', alt: section.settings.logo_9_alt
          }}

        </div>

      {% endif %}


      <!-- =================================================
        Logo 10 — FDA
        ================================================= -->
      {% if section.settings.logo_10 != blank %}

        <div class="wellie-certified__logo">

          {{
            section.settings.logo_10 | image_url: width: 160 | image_tag: loading: 'lazy', widths: '60, 80, 120, 160', sizes: '(min-width: 750px) 80px, 60px', alt: section.settings.logo_10_alt
          }}

        </div>

      {% endif %}


    </div>

  </div>

</section>


